<Window x:Class="TsubakiCursorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TsubakiCursor" Height="640" Width="920"
        WindowStartupLocation="CenterScreen"
        Background="#EBE1CF">

    <Window.Resources>
        <!-- ===== 色彩体系（书籍纸张风格） ===== -->
        <!-- 侧栏 #594C40  分隔线 #6E6052  内容背景 #EBE1CF  卡片 #F8F4EC  墨色 #3D3226
             淡墨 #8B7D6B  细墨 #A09888  边框 #D4C8B8  茶色 #8B5E3C -->

        <!-- ===== 滚动条样式 ===== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Background="#C0AE98" Width="6"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 主按钮（应用 / 下载 / 更新） ===== -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8B5E3C"/>
            <Setter Property="Foreground" Value="#F8F4EC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7A4F30"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#D4C8B8"/>
                    <Setter Property="Foreground" Value="#A09888"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== 次按钮（刷新 / 恢复） ===== -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B5E3C"/>
            <Setter Property="BorderBrush" Value="#8B5E3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0E8D8"/>
                    <Setter Property="BorderBrush" Value="#7A4F30"/>
                    <Setter Property="Foreground" Value="#7A4F30"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 侧边栏 ==================== -->
        <Border Background="#594C40" Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="20,28,20,20">
                    <TextBlock Text="TsubakiCursor"
                               Foreground="#F8F4EC"
                               FontSize="16"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI, Microsoft YaHei"/>
                    <TextBlock Text="神椿光标主题管理器"
                               Foreground="#C0B4A6"
                               FontSize="10"
                               Margin="0,2,0,0"
                               FontFamily="Microsoft YaHei"/>
                </StackPanel>

                <Border Grid.Row="1" Height="1" Background="#6E6052" Margin="20,0,20,8"/>

                <Grid Grid.Row="2" Margin="12,8,12,0">
                    <!-- 浮动高亮色块 Canvas -->
                    <Canvas>
                        <Border x:Name="NavHighlight" Canvas.Left="0"
                                Height="40" Width="176"
                                Background="#8B5E3C" CornerRadius="8"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                        </Border>
                    </Canvas>

                    <!-- 导航文字层 -->
                    <StackPanel>
                        <Border Cursor="Hand" MouseLeftButtonDown="NavUsing_Click"
                                Background="Transparent" Height="40" Margin="0,2">
                            <TextBlock Text="使用中"
                                       Foreground="#F8F4EC"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0"
                                       FontFamily="Microsoft YaHei" x:Name="NavUsingText"/>
                        </Border>
                        <Border Cursor="Hand" MouseLeftButtonDown="NavList_Click"
                                Background="Transparent" Height="40" Margin="0,2">
                            <TextBlock Text="主题列表"
                                       Foreground="#C0B4A6"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0"
                                       FontFamily="Microsoft YaHei" x:Name="NavListText"/>
                        </Border>
                        <Border Cursor="Hand" MouseLeftButtonDown="NavAbout_Click"
                                Background="Transparent" Height="40" Margin="0,2">
                            <TextBlock Text="关于"
                                       Foreground="#C0B4A6"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0"
                                       FontFamily="Microsoft YaHei" x:Name="NavAboutText"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== 内容区 ==================== -->
        <Grid Grid.Column="1" Margin="28,24">

            <!-- ===== 使用中页面 ===== -->
            <Grid x:Name="PageUsing">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="当前使用的鼠标指针"
                           Foreground="#3D3226"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,0,0,20"
                           FontFamily="Microsoft YaHei"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CursorsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="134" Height="106"
                                        Margin="7"
                                        Background="#F8F4EC"
                                        CornerRadius="10"
                                        BorderBrush="#D4C8B8"
                                        BorderThickness="1">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Border Width="40" Height="40"
                                                CornerRadius="20"
                                                Background="#F0E8D8">
                                            <Image Source="{Binding Image}"
                                                   Width="24" Height="24"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="#3D3226"
                                                   Margin="0,8,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="11"
                                                   FontFamily="Microsoft YaHei"/>
                                        <TextBlock Text="{Binding FileName}"
                                                   Foreground="#A09888"
                                                   Margin="0,2,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="9"
                                                   FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ===== 主题列表页面 ===== -->
            <Grid x:Name="PageList" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="主题列表"
                           Foreground="#3D3226"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,0,0,14"
                           FontFamily="Microsoft YaHei"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="刷新远程列表"
                            Click="BtnRefreshRemote_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0"/>
                    <Button Content="恢复默认光标"
                            Click="BtnRestoreDefault_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>

                <!-- Loading Bar -->
                <Border Grid.Row="2" x:Name="LoadingBar"
                        Visibility="Collapsed"
                        Height="3"
                        Margin="0,0,0,16"
                        Background="#E0D5C0"
                        CornerRadius="2"
                        ClipToBounds="True">
                    <Border Width="120"
                            Height="3"
                            Background="#8B5E3C"
                            CornerRadius="2"
                            HorizontalAlignment="Left"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform X="0"/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                            From="0" To="500" Duration="0:0:1.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                </Border>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ThemesList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="72"
                                        Margin="0,5"
                                        Background="#F8F4EC"
                                        CornerRadius="10"
                                        BorderBrush="#D4C8B8"
                                        BorderThickness="1">
                                    <Grid Margin="14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="4" CornerRadius="2"
                                                Background="#8B5E3C"
                                                VerticalAlignment="Stretch"
                                                Margin="0,14"/>

                                        <Border Grid.Column="1"
                                                Width="36" Height="36"
                                                CornerRadius="18"
                                                Background="#F0E8D8"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <Image Source="{Binding PreviewImage}"
                                                   Width="22" Height="22"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Margin="12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#3D3226"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           FontFamily="Microsoft YaHei"/>
                                                <TextBlock Text=" 远程"
                                                           Foreground="#A09888"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Microsoft YaHei"
                                                           Visibility="{Binding IsRemote, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Author}"
                                                       Foreground="#8B7D6B"
                                                       FontSize="11"
                                                       Margin="0,3,0,0"
                                                       FontFamily="Microsoft YaHei"/>
                                        </StackPanel>

                                        <Button Grid.Column="3"
                                                Content="{Binding ButtonText}"
                                                IsEnabled="{Binding IsButtonEnabled}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Width="76"
                                                Tag="{Binding}"
                                                Click="BtnApplyTheme_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ===== 关于页面 ===== -->
            <Grid x:Name="PageAbout" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="TsubakiCursor"
                               Foreground="#3D3226"
                               FontSize="28"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe UI, Microsoft YaHei"/>
                    <TextBlock Text="神椿光标主题管理器"
                               Foreground="#8B7D6B"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"
                               FontFamily="Microsoft YaHei"/>

                    <Border Width="60" Height="1" Background="#D4C8B8" Margin="0,24"/>

                    <TextBlock Text="版本 0.1.0"
                               Foreground="#8B7D6B"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe UI"/>

                    <TextBlock Foreground="#8B7D6B" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,16,0,0"
                               FontFamily="Microsoft YaHei">
                        <Run Text="项目地址："/>
                        <Hyperlink NavigateUri="https://github.com/MoriSakiTsu/TsubakiCursorApp"
                                   Foreground="#8B5E3C" TextDecorations="None">
                            GitHub
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock Text="开源协议：MIT License"
                               Foreground="#A09888"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               FontFamily="Segoe UI"/>

                    <TextBlock Text="光标资源版权归原作者所有"
                               Foreground="#A09888"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"
                               FontFamily="Microsoft YaHei"/>

                    <Border Width="40" Height="1" Background="#D4C8B8" Margin="0,24"/>

                    <TextBlock Text="ご使用ありがとうございます"
                               Foreground="#C4B8A8"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               FontStyle="Italic"
                               FontFamily="Segoe UI, Microsoft YaHei"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>