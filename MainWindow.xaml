<Window x:Class="TsubakiCursorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TsubakiCursor" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Border Background="#252526" Grid.Column="0">
            <StackPanel>
                <TextBlock Text="TsubakiCursor" 
                           Foreground="White" 
                           FontSize="15" 
                           FontWeight="Bold"
                           Margin="16,20,16,30"/>
                
                <Border x:Name="NavUsing" 
                        Background="#3c3c3c" 
                        Cursor="Hand"
                        MouseLeftButtonDown="NavUsing_Click">
                    <TextBlock Text="|使用中" 
                               Foreground="White"
                               FontSize="13"
                               Margin="16,14"/>
                </Border>
                
                <Border x:Name="NavList" 
                        Background="Transparent" 
                        Cursor="Hand"
                        MouseLeftButtonDown="NavList_Click">
                    <TextBlock Text="|列表" 
                               Foreground="#cccccc"
                               FontSize="13"
                               Margin="16,14"/>
                </Border>
                
                <Border x:Name="NavAbout" 
                        Background="Transparent" 
                        Cursor="Hand"
                        MouseLeftButtonDown="NavAbout_Click">
                    <TextBlock Text="|关于" 
                               Foreground="#cccccc"
                               FontSize="13"
                               Margin="16,14"/>
                </Border>
            </StackPanel>
        </Border>
        
        <Grid Grid.Column="1" Margin="20">
            <Grid x:Name="PageUsing">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="当前使用的鼠标指针" 
                           Foreground="White" 
                           FontSize="20" 
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>
                
                <ScrollViewer Grid.Row="1" 
                            VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CursorsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="140" Height="110" 
                                        Margin="8" 
                                        Background="#2d2d30" 
                                        CornerRadius="8"
                                        BorderBrush="#3e3e42"
                                        BorderThickness="1">
                                    <StackPanel HorizontalAlignment="Center" 
                                                VerticalAlignment="Center">
                                        <Image Source="{Binding Image}" 
                                               Width="32" Height="32" 
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding Name}" 
                                                   Foreground="#cccccc"
                                                   Margin="0,8,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding FileName}" 
                                                   Foreground="#666666"
                                                   Margin="0,2,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="10"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            
            <Grid x:Name="PageList" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="主题列表" 
                        Foreground="White" 
                        FontSize="20" 
                        FontWeight="Bold"
                        Margin="0,0,0,12"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="|刷新远程列表" 
                            Click="BtnRefreshRemote_Click"
                            Background="#3c3c3c" 
                            Foreground="White" 
                            BorderThickness="0"
                            Padding="12,6"
                            Margin="0,0,10,0"/>
                    <Button Content="|恢复默认光标" 
                            Click="BtnRestoreDefault_Click"
                            Background="#3c3c3c" 
                            Foreground="White" 
                            BorderThickness="0"
                            Padding="12,6"/>
                </StackPanel>
                <ScrollViewer Grid.Row="2" 
                            VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ThemesList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="70" 
                                        Margin="0,6" 
                                        Background="#2d2d30" 
                                        CornerRadius="8"
                                        BorderBrush="#3e3e42"
                                        BorderThickness="1">
                                    <Grid Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding PreviewImage}" 
                                            Width="32" Height="32" 
                                            Stretch="Uniform"
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" 
                                                    VerticalAlignment="Center" 
                                                    Margin="10,0">
                                            <TextBlock Text="{Binding Name}" 
                                                    Foreground="White" 
                                                    FontSize="14"/>
                                            <TextBlock Text="{Binding Author}" 
                                                    Foreground="#888888" 
                                                    FontSize="12" 
                                                    Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" 
                                                Content="{Binding ButtonText}" 
                                                IsEnabled="{Binding IsButtonEnabled}"
                                                Width="80" 
                                                Height="32" 
                                                Background="#3c3c3c" 
                                                Foreground="White" 
                                                BorderThickness="0"
                                                Tag="{Binding}"
                                                Click="BtnApplyTheme_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            
            <Grid x:Name="PageAbout" Visibility="Collapsed">
                <TextBlock Text="TsubakiCursor v0.1" 
                           Foreground="#888888"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>